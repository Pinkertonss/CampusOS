# CampusOS Environment Variables Configuration
# Copy this file to .env or backend/.env and frontend/.env.local

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# Supabase Configuration
# Obtain from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# LLM API for RAG Campus Copilot (e.g. Gemini API or OpenAI API)
# If left blank, CampusOS defaults to its intelligent built-in semantic retrieval
# and deterministic local citation engine so it runs seamlessly offline for hackathon demos.
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
