# CampusOS Monorepo Environment Variables Template
# Copy this file to .env, or use individual .env files in /backend and /frontend

# ===========================================================================
# BACKEND (FastAPI)
# ===========================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# Supabase Auth, Database & Storage Configuration
# Obtain from your Supabase Project Settings -> API & JWT Settings
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# LLM Providers for Grounded Copilot (Optional)
# If omitted, CampusOS utilizes its built-in grounded semantic citation engine
GEMINI_API_KEY=
OPENAI_API_KEY=

# ===========================================================================
# FRONTEND (Next.js)
# ===========================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
